# Only what is genuinely repo-wide lives here. Everything a module generates is
# ignored by that module's own .gitignore, next to the code that writes it:
#   openscad/  -> out/            (meshes, renders)
#   openfoam/  -> input/, out/    (staged geometry, cases, coefficients)
#   optimizer/ -> input/, out/    (generated config, search results)
#   trajectory/-> out/            (plots, local binaries)

# Python bytecode
__pycache__/
*.py[cod]

# Environments and tool caches
.venv
.env
.envrc
.ruff_cache/

# macOS
.DS_Store
